FROM rust:1.99-bookworm AS build
WORKDIR /build
COPY backend/Cargo.toml backend/Cargo.lock ./
COPY backend/build.rs backend/schema.sql ./
COPY backend/proto ./proto
COPY backend/src ./src
RUN cargo build --release --locked

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=build /build/target/release/rainy-wallpaper /usr/local/bin/rainy-wallpaper
USER 65532:65532
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=3 CMD ["/usr/local/bin/rainy-wallpaper","--healthcheck"]
ENTRYPOINT ["/usr/local/bin/rainy-wallpaper"]
